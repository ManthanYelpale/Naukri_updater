# -------------------------------------------------------------------
# Naukri Resume Auto-Updater — configuration
# Copy this file to ".env" (same folder as the script) and fill it in.
# -------------------------------------------------------------------

# Path to the resume file you want re-uploaded.
RESUME_PATH=/full/path/to/your/resume.pdf

# Used for the FIRST login only, and again whenever the saved session
# expires — not on every run. Quote the password if it contains a "#",
# otherwise everything from the "#" onward is treated as a comment and
# silently dropped.
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD="your_password"

# Where the script keeps its own logged-in Chrome profile. It reuses this
# session every run, so it signs in a handful of times a year instead of
# on every single run — which is what keeps it from looking like a bot.
# Delete this folder to force a fresh login.
#
# This must NOT be your real Chrome profile (e.g. %LOCALAPPDATA%\Google\
# Chrome\User Data): since Chrome 136 (May 2025) ChromeDriver refuses to
# automate the default profile directory and Chrome dies at startup with
# "DevToolsActivePort file doesn't exist". Use a dedicated folder.
SESSION_PROFILE_DIR=/full/path/to/browser_profile

# true = visible browser window instead of headless. Use this to sign in by
# hand the first time, or to clear a CAPTCHA if one ever appears.
SHOW_BROWSER=false
